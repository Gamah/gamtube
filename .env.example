DATABASE_URL=sqlite:///./gamtube.db
MEDIA_ROOT=./media
MEDIA_BASE_URL=http://localhost:8000/media  # local dev; in prod, set to your domain (no port if behind nginx)
STORAGE_BACKEND=local
BASE_URL=http://localhost:8000              # local dev; in prod, set to https://your.domain.tld
TEMP_DIR=
VIDEO_TTL_HOURS=24          # hours until hosted file is deleted and re-fetched on next visit; 0 = never
TRANSCODE_ENABLED=false     # re-encode to H.264 MP4 on ingest; false = serve as downloaded (faster, raw format)
ADMIN_PASSWORD=             # password for /manage panel; leave empty to disable
# S3 (only used when STORAGE_BACKEND=s3):
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
