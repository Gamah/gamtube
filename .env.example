# One .env serves both processes. Each reads only its own keys and ignores
# the other's, so blank bot keys cost the web app nothing.

# --- web ---
DATABASE_URL=sqlite:///./gamtube.db
MEDIA_ROOT=./media
MEDIA_BASE_URL=http://localhost:8000/media  # local dev; in prod, set to your domain (no port if behind nginx)
STORAGE_BACKEND=local
BASE_URL=http://localhost:8000              # local dev; in prod, set to https://your.domain.tld
TEMP_DIR=
VIDEO_TTL_HOURS=24          # hours until hosted file is deleted and re-fetched on next visit; 0 = never
TRANSCODE_ENABLED=false     # re-encode to H.264 MP4 on ingest; false = serve as downloaded (faster, raw format)
ADMIN_PASSWORD=             # password for /manage panel; leave empty to disable
# S3 (only used when STORAGE_BACKEND=s3):
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- bot ---
DISCORD_BOT_TOKEN=          # from the Discord developer portal; empty = bot disabled
CHANNEL_OPT_IN=true         # a channel is enabled only where it explicitly grants the bot OPT_IN_PERMISSION
OPT_IN_PERMISSION=embed_links    # the channel permission that means "yes, act here"
DISCORD_GUILDS=             # comma-separated guild ids; empty = every guild it's invited to
DISCORD_CHANNELS=           # comma-separated channel ids; empty = every channel it can read
EMBED_WAIT_SECONDS=3.0      # how long to let Discord unfurl before judging a message
LINK_TTL_SECONDS=300        # how long a posted link keeps working; Discord only needs to unfurl it
MAX_ITEM_MB=100             # skip anything bigger than this; it is held in RAM, not attached
MAX_MEMORY_MB=512           # total budget across all live links, oldest evicted first
FORCE_MP4=true              # re-encode to H.264 mp4 if the download isn't already
LINK_NOTE=(clicking this link does nothing)   # appended under the link; empty for none
WARMUP_CHANNEL_ID=0         # 0 = off. Set a throwaway channel id in the same guild and the bot
                            # posts the link there first, waits until Discord has pulled the
                            # whole file, deletes it, then posts for real, so the player lands
                            # with the message instead of filling in afterwards.
WARMUP_TIMEOUT_SECONDS=20.0 # give up warming after this and post anyway
WARMUP_SETTLE_SECONDS=3.0   # pause after Discord finishes pulling, for its own processing
ACK_MODE=reaction           # reaction | message | none. How to say "working on it" while
                            # downloading. reaction needs Add Reactions on the channel and
                            # falls back to message without it.
ACK_KEEP_REACTION=true      # in reaction mode, leave the check in place as a "handled" marker
# ACK_TEXT / ACK_FAILED_TEXT / ACK_EMOJI / ACK_FAILED_EMOJI override the
# wording. Avoid ' " and # in the value: systemd parses this file and treats
# them as quoting and comments.
BOT_DEBUG=false             # verbose: full /d/ request headers, per-stage timings,
                            # and poll the message so the real unfurl delay is measured
HUMAN_NOTICE=true           # show a "this is for Discord" page to people who open /d/ in a browser
CRAWLER_USER_AGENTS=        # who counts as a link crawler; empty = bot/agents.py DEFAULT_CRAWLERS
MEDIA_USER_AGENTS=          # UA substrings allowed to fetch the VIDEO; empty = anyone.
                            # NOT the crawler list: Discord's media proxy is not its unfurler.
                            # Fill from the 'media ... ua=' lines in app.log before setting.
MAX_LINKS_PER_MESSAGE=3
SHRINK_ENABLED=true         # one re-encode attempt when a download lands over the cap
SHRINK_CRF=30
SHRINK_MAX_HEIGHT=720
WATCH_DOMAINS=              # comma-separated; empty = the built-in list in bot/detect.py
BOT_TEMP_DIR=               # defaults to TEMP_DIR's system default; a tmpfs path keeps it off disk
