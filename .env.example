# One .env serves both processes. Each reads only its own keys and ignores
# the other's, so blank bot keys cost the web app nothing.

# --- web ---
DATABASE_URL=sqlite:///./gamtube.db
MEDIA_ROOT=./media
MEDIA_BASE_URL=http://localhost:8000/media  # local dev; in prod, set to your domain (no port if behind nginx)
STORAGE_BACKEND=local
BASE_URL=http://localhost:8000              # local dev; in prod, set to https://your.domain.tld
TEMP_DIR=
VIDEO_TTL_HOURS=24          # hours until hosted file is deleted and re-fetched on next visit; 0 = never
TRANSCODE_ENABLED=false     # re-encode to H.264 MP4 on ingest; false = serve as downloaded (faster, raw format)
ADMIN_PASSWORD=             # password for /manage panel; leave empty to disable
# S3 (only used when STORAGE_BACKEND=s3):
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- bot ---
# deploy.sh writes only DISCORD_BOT_TOKEN from this section. Everything else is
# a code default in bot/config.py and is listed here for reference only: set one
# of them here and it overrides the default forever, including after an upgrade
# that changes it. A transient override is better done as a systemd
# Environment= drop-in, which deploy.sh never rewrites.
DISCORD_BOT_TOKEN=          # from the Discord developer portal; empty = bot disabled
#
# DISCORD_GUILDS=                comma-separated guild ids; empty = all
# DISCORD_CHANNELS=              comma-separated channel ids; empty = all
# EMBED_WAIT_SECONDS=3.0         how long to let Discord unfurl before judging
# LINK_TTL_SECONDS=300           how long a posted link keeps working
# MAX_ITEM_MB=100                skip a single video bigger than this
# MAX_MEMORY_MB=512              total store budget; oldest evicted first
# UPLOAD_ENABLED=true            attach the file when it fits the guild cap
# UPLOAD_TIMEOUT_SECONDS=45.0    one attempt, then fall back to posting a link
# UPLOAD_MIN_BITRATE_KBPS=900    below this, post the link rather than shrink to fit
# FORCE_MP4=true                 normalise to H.264 mp4 if the download is not
# SHRINK_ENABLED=true            one re-encode attempt when over MAX_ITEM_MB
# SHRINK_CRF=30
# SHRINK_MAX_HEIGHT=720
# MAX_LINKS_PER_MESSAGE=3
# WATCH_DOMAINS=                 empty = the built-in list in bot/detect.py
# ACK_MODE=reaction              reaction | message | none
# ACK_OUTCOME_REACTION=true      swap the working marker for an outcome emoji
# EMOJI_WORKING / _UPLOADED / _OVERSIZE / _FORBIDDEN / _THROTTLED / _FALLBACK
# EMOJI_FAILED                   one emoji per outcome; see docs/bot.md
# LINK_NOTE=(clicking this link does nothing)
# WARMUP_CHANNEL_ID=0            0 = off; a throwaway channel in the same guild
# WARMUP_TIMEOUT_SECONDS=20.0
# WARMUP_SETTLE_SECONDS=3.0
# HUMAN_NOTICE=true              people get a notice page instead of og: tags
# CRAWLER_USER_AGENTS=           empty = the built-in list in bot/agents.py
# MEDIA_USER_AGENTS=             empty = anyone may fetch the video
# BOT_TEMP_DIR=                  a tmpfs path keeps downloads off disk
# BOT_DEBUG=false                header dumps, stage timings, embed polling
